            document.getElementById('content-' + tabId).classList.add('active');
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById('tab-' + tabId).classList.add('active');
        }

        // === ГРАФИКИ (только три модели) ===
        document.addEventListener('DOMContentLoaded', function() {
            // 1. VRAM и пропускная способность
            new Chart(document.getElementById('chartSpecs'), {
                type: 'bar',
                data: {
                    labels: ['L40S', 'A100', 'A40'],
                    datasets: [
                        { label: 'VRAM (ГБ)', data: [48, 80, 48], backgroundColor: ['#f59e0b', '#6366f1', '#94a3b8'] },
                        { label: 'Пропускная способность (ГБ/с)', data: [864, 2000, 696], backgroundColor: ['#fbbf24', '#818cf8', '#cbd5e1'] }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { labels: { color: '#475569' } } },
                    scales: {
                        y: { grid: { color: 'rgba(148,163,184,0.2)' }, ticks: { color: '#64748b' } },
                        x: { ticks: { color: '#64748b' } }
                    }
                }
            });

            // 2. FP16/FP8
            new Chart(document.getElementById('chartFlops'), {
                type: 'bar',
                data: {
                    labels: ['L40S', 'A100', 'A40'],
                    datasets: [
                        { label: 'FP16 Tensor (TFLOPS)', data: [366, 624, 150], backgroundColor: '#6366f1' },
                        { label: 'FP8/INT8 Tensor (TFLOPS)', data: [733, 0, 0], backgroundColor: '#f59e0b' }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { labels: { color: '#475569' } } },
                    scales: {
                        y: { grid: { color: 'rgba(148,163,184,0.2)' }, ticks: { color: '#64748b' } },
                        x: { ticks: { color: '#64748b' } }
                    }
                }
            });

            // 3. Llama-3-8B
            new Chart(document.getElementById('chartLlama3'), {
                type: 'bar',
                data: {
                    labels: ['L40S (FP8)', 'A100 (INT8)', 'A40 (INT8)'],
                    datasets: [{ label: 'Tokens/сек (BS=32)', data: [420, 280, 180], backgroundColor: ['#f59e0b', '#6366f1', '#94a3b8'] }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { grid: { color: 'rgba(148,163,184,0.2)' }, ticks: { color: '#64748b' } },
                        x: { ticks: { color: '#64748b' } }
                    }
                }
            });

            // 4. Qwen-72B (только три модели)
            new Chart(document.getElementById('chartQwen72B'), {
                type: 'bar',
                data: {
                    labels: ['L40S (2x, PCIe)', 'A100 (2x, NVLink)', 'A40 (2x, NVLink)'],
                    datasets: [{ label: 'Tokens/сек (BS=16)', data: [95, 210, 70], backgroundColor: ['#f59e0b', '#6366f1', '#94a3b8'] }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { grid: { color: 'rgba(148,163,184,0.2)' }, ticks: { color: '#64748b' } },
                        x: { ticks: { color: '#64748b' } }
                    }
                }
            });

            // 5. TCO (только три модели, раздельный и совмещенный)
            new Chart(document.getElementById('chartTco'), {
                type: 'bar',
                data: {
                    labels: ['A40 (раздельный)', 'L40S (раздельный)', 'A100 (раздельный)', 'A40 (совмещ.)', 'L40S (совмещ.)'],
                    datasets: [
                        { label: 'TCO 1-й год (млн ₽)', data: [8.93, 16.60, 22.55, 3.70, 7.29], backgroundColor: ['#94a3b8', '#f59e0b', '#6366f1', '#94a3b8', '#f59e0b'] },
                        { label: 'Электроэнергия (млн ₽/год)', data: [0.260, 0.285, 0.325, 0.126, 0.142], backgroundColor: ['#cbd5e1', '#fbbf24', '#818cf8', '#cbd5e1', '#fbbf24'] }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { labels: { color: '#475569' } } },
                    scales: {
                        y: { grid: { color: 'rgba(148,163,184,0.2)' }, ticks: { color: '#64748b' } },
                        x: { ticks: { color: '#64748b' } }
                    }
                }
            });

            // === Симулятор (только три модели) ===
            const gpuData = {
                a40: { capex: 2.80, tco: 3.70, label: 'A40' },
                l40s: { capex: 5.85, tco: 7.29, label: 'L40S' },
                a100: { capex: 19.70, tco: 22.55, label: 'A100' }
            };

            document.getElementById('gpuSelect').addEventListener('change', updateCalculator);
            document.getElementById('gpuCount').addEventListener('input', function() {
                document.getElementById('gpuCountLabel').textContent = this.value;
                updateCalculator();
            });
            document.getElementById('concurrentLoad').addEventListener('input', function() {
                document.getElementById('concurrentLabel').textContent = this.value;
                updateCalculator();
            });

            function updateCalculator() {
                const gpu = document.getElementById('gpuSelect').value;
                const count = parseInt(document.getElementById('gpuCount').value);
                const data = gpuData[gpu];
                const capex = (data.capex * count / 4).toFixed(2);
                const tco = (data.tco * count / 4 + (count * 0.05)).toFixed(2);
                document.getElementById('capexResult').textContent = capex + ' млн ₽';
                document.getElementById('tcoResult').textContent = tco + ' млн ₽';
            }
            updateCalculator();
        });
    </script>
</body>
</html>
